{
  "name": "fleetsmith",
  "version": "0.7.1",
  "description": "Meta agent-fleet builder: compile one fleet spec into coordinated agent teams, skills, and handover protocols for Claude Code, opencode, and goose.",
  "type": "module",
  "bin": {
    "fleetsmith": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./adapters": "./src/adapters/index.js",
    "./spec": "./src/spec/index.js",
    "./opencode": "./src/opencode.js",
    "./memory/port": "./src/memory/port.js",
    "./memory/file": "./src/memory/file.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "node scripts/ee-selflink.mjs",
    "test": "node --test",
    "bundle": "node scripts/bundle.mjs",
    "build:binary": "node scripts/bundle.mjs && node scripts/build-binary.mjs",
    "smoke:binary": "node scripts/smoke-binary.mjs",
    "build:binary:macos-x64": "node scripts/bundle.mjs && node scripts/build-binary.mjs --arch x64",
    "build:example": "node src/cli.js build fleet.example.yaml --target all --out ./dist-example",
    "publish-check": "node scripts/publish-check.mjs",
    "prepublishOnly": "npm test && node scripts/publish-check.mjs"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "claude-code",
    "opencode",
    "goose",
    "agent-skills",
    "harness",
    "orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subhransusekhar/fleetsmith.git"
  },
  "homepage": "https://github.com/subhransusekhar/fleetsmith#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6"
  }
}
